# Secrets and endpoints only. Model IDs and every result-affecting
# parameter live in config/*.yaml.

# ===== Generation LLM (OpenAI-compatible endpoint) =====
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

# ===== Judge LLM (RAGAS) - kept separate even if it is the same endpoint =====
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=

# ===== Local llama.cpp server (phase 8) =====
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
# Leave empty for local use
QDRANT_API_KEY=

# ===== Langfuse (Cloud) =====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Runtime =====
LOG_LEVEL=INFO
# Optional model cache folder, e.g. D:\models\hf
HF_HOME=
